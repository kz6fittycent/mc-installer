#!/bin/bash

# Drop GNOME's GPU-offload settings where they'd point at the GPU that
# already drives the display (see gpu-env.sh).
source "$(dirname "${BASH_SOURCE[0]}")/gpu-env.sh"
fix_gpu_offload

set -e
(
	cd $SNAP_USER_DATA
	$SNAP/download-launcher.py
)

set -e
(
	$SNAP_USER_DATA/minecraft-launcher/./minecraft-launcher
)
