[Desktop Entry]
Name=MC Mods
GenericName=Minecraft Mod Manager
Comment=Install Fabric, mods, resource packs and modpacks for Minecraft
Exec=mc-installer.mods
Icon=${SNAP}/meta/gui/mcmods.png
