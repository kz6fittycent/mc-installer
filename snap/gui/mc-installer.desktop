[Desktop Entry]
Name=Minecraft
GenericName=Minecraft Installer
Comment=A simple installer for Minecraft - Java Edition
Exec=mc-installer
Icon=${SNAP}/meta/gui/mcinstaller.png
Terminal=false
Type=Application
StartupNotify=false
PrefersNonDefaultGPU=true
Categories=Game;
Keywords=mc-installer;
Actions=mods;

[Desktop Action mods]
Name=Set Up Mods
Exec=mc-installer.mods
